package states.substates.menus;

import flixel.FlxSprite;
import game.objects.Camera;
import flixel.text.FlxText;
import core.json.menus.OptionData;
import flixel.graphics.frames.FlxAtlasFrames;
import states.substates.menus.options.Keybind;
import flixel.tweens.FlxTween;
import flixel.tweens.FlxEase;
import flixel.util.FlxSpriteUtil;

class OptionsMenuSubstate extends states.substates.BlurSubState {
	var categoryTexts:Array<FlxText> = [];
	var categoryGraphics:Array<FlxSprite> = [];
	var categories:Array<String> = ['Visual', 'Gameplay', 'Keybinds', 'Debug'];
	var curCategory:Int = 0;

	var contentCam:Camera;
	var keybindsMenu:states.substates.menus.options.KeybindsMenu;

	static final CONTENT_H:Int = 412;

	var gridBg:FlxSprite;

	var categoryOptions:Map<String, Array<OptionData>> = [
		'Visual' => [
			#if desktop
			{
				name: 'Screen Mode',
				description: 'Toggle between full screen, borderless and windowed mode.',
				saveField: 'windowmode',
				type: STRING(['Fullscreen', 'Borderless', 'Windowed'])
			},
			#end
			{
				name: 'Framerate',
				description: 'Adjust the frames per second limit.',
				saveField: 'framerate',
				type: NUMBER(30, 240, 5)
			},
			{
				name: 'Antialiasing',
				description: 'Softens the edges of the images.',
				saveField: 'antialiasing',
				type: CHECKBOX
			},
			{
				name: 'Shaders',
				description: 'Enables advanced visual effects.',
				saveField: 'shaders',
				type: CHECKBOX
			}
		],
		'Gameplay' => [
			{
				name: 'Downscroll',
				description: 'Reverse the direction of the notes downwards.',
				saveField: 'downscroll',
				type: CHECKBOX
			},
			{
				name: 'Middlescroll',
				description: 'Center your notes on the screen.',
				saveField: 'middlescroll',
				type: CHECKBOX
			},
			{
				name: 'Ghost Tapping',
				description: 'Avoid penalties when pressing keys without notes.',
				saveField: 'ghosttaping',
				type: CHECKBOX
			},
			{
				name: 'Lane Backdrop',
				description: 'Increase or decrease the opacity of the lane background in your notes.',
				saveField: 'laneBackdrop',
				type: NUMBER(0, 100, 5),
				displayFormat: '%'
			},
			{
				name: 'Combo Position',
				description: 'Move the rating position wherever you like.',
				saveField: null,
				type: null
			},
			{
				name: 'Camera Movements',
				description: "Camera shifts slightly based on the character's current pose animation.",
				saveField: 'cameraMovement',
				type: CHECKBOX
			}
		],
		'Keybinds' => [],
		'Debug' => [
			{
				name: 'Log In Screen',
				description: 'Make the logs generated by the game console visible on screen.',
				saveField: 'logInScreen',
				type: CHECKBOX
			},
			{
				name: 'Bot Play',
				description: 'Enable bot play mode.',
				saveField: 'botplay',
				type: CHECKBOX
			}
		]
	];

	var curSelectedOption:Int = 0;
	var itemTexts:Array<FlxText> = [];
	var valueTexts:Array<FlxSprite> = [];
	var descText:FlxText;

	var isCategory:Bool = true;

	// Character preview
	var character:game.objects.sprites.Character;

	public function new(?targetCams:Array<flixel.FlxCamera>)
		super(2.0, targetCams);

	override public function create() {
		super.create();

		FlxG.mouse.visible = true;

		contentCam = new Camera(330, 130, 900, CONTENT_H);
		contentCam.bgColor = 0x00000000;
		FlxG.cameras.add(contentCam, false);

		var bg:FlxSprite = new FlxSprite().makeGraphic(FlxG.width, FlxG.height, 0xFF050505);
		bg.alpha = 0.7;
		add(bg);

		gridBg = new FlxSprite(30, 130);
		gridBg.makeGraphic(1220, 565, 0xCC0E0E0E, true);
		var cellSize:Int = 28;
		var lineColor:Int = 0x12FFFFFF;
		for (gx in 0...Std.int(1220 / cellSize) + 2)
			FlxSpriteUtil.drawLine(gridBg, gx * cellSize, 0, gx * cellSize, 565, {color: lineColor, thickness: 1});
		for (gy in 0...Std.int(565 / cellSize) + 2)
			FlxSpriteUtil.drawLine(gridBg, 0, gy * cellSize, 1220, gy * cellSize, {color: lineColor, thickness: 1});
		gridBg.scrollFactor.set(0, 0);
		add(gridBg);

		var limit:FlxSprite = new FlxSprite().loadGraphic(Paths.getPath('menus/options/LimitsMenu', 'image'));
		limit.screenCenter();
		limit.y += 50;
		add(limit);

		var options:FlxSprite = new FlxSprite(0, 10);
		options.frames = Paths.getPath('menus/options/Options', 'animated');
		options.animation.addByPrefix('idle', 'Options', 24, true);
		options.animation.play('idle');
		options.screenCenter(X);
		add(options);

		for (i in 0...categories.length) {
			var text:FlxText = new FlxText(50, 150 + (i * 50), 0, categories[i]);
			text.setFormat(Paths.getPath('Funkin.otf', 'font'), 34, 0xFFFFFFFF, "left");
			text.ID = i;
			text.setBorderStyle(FlxTextBorderStyle.OUTLINE, 0xFF000000, 1, 1);
			text.antialiasing = SaveData.data.antialiasing;
			text.scrollFactor.set(0, 0);
			categoryTexts.push(text);
			add(text);

			var catName = categories[i];
			var image:FlxSprite = new FlxSprite(text.x + text.width + 10, text.y);
			image.frames = Paths.getPath('menus/options/sections', 'animated');
			image.animation.addByPrefix(catName, catName + '_symbol0000', 24, false);
			image.animation.play(catName);
			image.scale.set(0.7, 0.7);
			image.updateHitbox();
			image.antialiasing = SaveData.data.antialiasing;
			categoryGraphics.push(image);
			add(image);
		}

		descText = new FlxText(350, bg.y + bg.height - 140, bg.width - 70, "");
		descText.setFormat(Paths.getPath('Funkin.otf', 'font'), 20, 0xFFFFFF00, "left");
		descText.setBorderStyle(FlxTextBorderStyle.OUTLINE, 0xFF000000, 1.5, 1);
		add(descText);

		try {
			character = new game.objects.sprites.Character('bf', 'bf', 500, 150);
		} catch (e:Dynamic) {
			Console.log('Warning: The character could not be loaded in the secondary menu. Reason: $e\n${haxe.CallStack.toString(haxe.CallStack.exceptionStack())}');
			character = null;
		}

		if (character != null) {
			character.visible = false;
			character.setPosition(FlxG.width - 450, FlxG.height - 500);
			character.scale.set(0.7, 0.7);
			character.updateHitbox();
			if (character.layers != null) {
				for (layer in character.layers) {
					if (layer != null) {
						layer.scale.set(0.7, 0.7);
						layer.visible = false;
						add(layer);
					}
				}
			}
			add(character);
		}

		if (character != null) {
			character.dance();
		}

		var modOpts = modding.mods.ModOptionsLoader.load();
		for (catName => opts in modOpts) {
			if (!categoryOptions.exists(catName)) {
				categories.push(catName);
				categoryOptions.set(catName, opts);
			} else {
				categoryOptions.get(catName).concat(opts);
			}
		}

		changeCategory(0);
		updateVisualFocus();

		bg.alpha = 0;
		FlxTween.tween(bg, {alpha: 0.7}, 0.35, {ease: FlxEase.quadOut});

		var limitOrigY = limit.y;
		limit.y += 40;
		limit.alpha = 0;
		FlxTween.tween(limit, {alpha: 1, y: limitOrigY}, 0.55, {ease: FlxEase.expoOut, startDelay: 0.05});

		var optOrigY = options.y;
		options.y -= 28;
		options.alpha = 0;
		FlxTween.tween(options, {alpha: 1, y: optOrigY}, 0.55, {ease: FlxEase.backOut, startDelay: 0.08});

		gridBg.alpha = 0;
		FlxTween.tween(gridBg, {alpha: 1}, 0.4, {ease: FlxEase.quadOut, startDelay: 0.14});

		for (i in 0...categoryTexts.length) {
			var txt = categoryTexts[i];
			var origX = txt.x;
			txt.x -= 55;
			txt.alpha = 0;
			FlxTween.tween(txt, {alpha: 1, x: origX}, 0.45, {ease: FlxEase.expoOut, startDelay: 0.12 + i * 0.075});
		}

		for (i in 0...categoryGraphics.length) {
			var spr = categoryGraphics[i];
			spr.alpha = 0;
			FlxTween.tween(spr, {alpha: 1}, 0.4, {ease: FlxEase.quadOut, startDelay: 0.18 + i * 0.075});
		}

		descText.alpha = 0;
		FlxTween.tween(descText, {alpha: 1}, 0.4, {ease: FlxEase.quadOut, startDelay: 0.42});
	}

	function changeCategory(change:Int = 0) {
		curCategory = (curCategory + change + categories.length) % categories.length;

		for (i in 0...categoryTexts.length)
			categoryTexts[i].color = (i == curCategory) ? 0xFFFFFF00 : 0xFFFFFFFF;

		curSelectedOption = 0;

		reloadOptions();
	}

	function reloadOptions() {
		contentCam.scroll.y = 0;

		if (keybindsMenu != null) {
			remove(keybindsMenu);
			keybindsMenu.destroy();
			keybindsMenu = null;
		}

		for (txt in itemTexts) {
			FlxTween.cancelTweensOf(txt);
			txt.destroy();
		}
		for (val in valueTexts) {
			FlxTween.cancelTweensOf(val);
			val.destroy();
		}
		itemTexts = [];
		valueTexts = [];

		if (categories[curCategory] == 'Keybinds') {
			core.audio.SoundFX.randomPitch(Paths.getPath('menus/scrollMenu', 'sound'), 0.9, 1.1);
			keybindsMenu = new states.substates.menus.options.KeybindsMenu(contentCam);
			add(keybindsMenu);
			return;
		}

		var currentList = categoryOptions.get(categories[curCategory]);
		if (currentList == null)
			return;

		for (i in 0...currentList.length) {
			var opt = currentList[i];

			var optText:FlxText = new FlxText(20, 20 + (i * 50), 0, opt.name);
			optText.setFormat(Paths.getPath('Funkin.otf', 'font'), 26, 0xFFFFFFFF, "left");
			optText.setBorderStyle(FlxTextBorderStyle.OUTLINE, 0xFF000000, 1, 1);
			optText.cameras = [contentCam];
			itemTexts.push(optText);
			add(optText);

			var valSprite:FlxSprite;

			if (opt.type == null) {
				var placeholder = createText('');
				placeholder.y += (i * 50);
				valSprite = placeholder;
				valueTexts.push(valSprite);
				add(valSprite);
				continue;
			}

			var rawValue = Reflect.field(SaveData.data, opt.saveField);

			switch (opt.type) {
				case CHECKBOX:
					valSprite = new FlxSprite(900 - 200, 15 + (i * 50));
					valSprite.frames = Paths.getPath('menus/options/check_box', 'animated');
					valSprite.animation.addByPrefix('uncheck', 'UnCheck0000', 24, false);
					valSprite.animation.addByPrefix('check', 'Check0000', 24, false);
					valSprite.animation.addByPrefix('to_check', 'To_Check', 24, false);
					valSprite.animation.addByPrefix('to_uncheck', 'To_UnCheck', 24, false);
					valSprite.cameras = [contentCam];

					valSprite.animation.play('check', true);

					if (rawValue == true) {
						valSprite.animation.play('check', true);
					} else {
						valSprite.animation.play('uncheck', true);
					}
					valSprite.scale.set(0.5, 0.5);
					valSprite.updateHitbox();

				case NUMBER(min, max, step):
					var displayFormat = opt.displayFormat;
					if (displayFormat == null)
						displayFormat = '';

					var valText = createText(Std.string(rawValue) + displayFormat);
					valText.y += (i * 50);
					valSprite = valText;
					valText.text = '< ' + Std.string(Reflect.field(SaveData.data, opt.saveField)) + displayFormat + ' >';
				case STRING(options):
					var rawVal:Dynamic = rawValue;
					var index:Int = 0;

					if (Std.isOfType(rawVal, Int))
						index = cast(rawVal, Int);
					else if (Std.isOfType(rawVal, Float))
						index = Std.int(cast(rawVal, Float));
					else if (Std.isOfType(rawVal, Bool))
						index = (rawVal : Bool) ? 0 : 1;
					else if (Std.isOfType(rawVal, String)) {
						index = options.indexOf(cast(rawVal, String));
						if (index < 0)
							index = 0;
					}
					if (index < 0 || index >= options.length)
						index = 0;

					var valText = createText(options[index]);
					valText.y += (i * 50);
					valSprite = valText;
					valText.text = '< ' + Std.string(Reflect.field(SaveData.data, opt.saveField)) + ' >';
			}
			valueTexts.push(valSprite);
			add(valSprite);
		}

		updateSelection(0);

		for (i in 0...itemTexts.length) {
			var txt = itemTexts[i];
			var origX = txt.x;
			txt.x -= 22;
			txt.alpha = 0;
			FlxTween.tween(txt, {x: origX, alpha: 1}, 0.28, {ease: FlxEase.expoOut, startDelay: i * 0.038});
		}
		for (i in 0...valueTexts.length) {
			var spr = valueTexts[i];
			spr.alpha = 0;
			FlxTween.tween(spr, {alpha: 1}, 0.22, {ease: FlxEase.quadOut, startDelay: 0.04 + i * 0.038});
		}
	}

	function createText(text:String):FlxText {
		var valText = new FlxText(330 + 355, 20, 0, text);
		valText.setFormat(Paths.getPath('Funkin.otf', 'font'), 26, 0xFFFFFFFF, "right");
		valText.setBorderStyle(FlxTextBorderStyle.OUTLINE, 0xFF000000, 1, 1);
		valText.cameras = [contentCam];
		return valText;
	}

	function updateSelection(change:Int = 0) {
		var currentList = categoryOptions.get(categories[curCategory]);

		core.audio.SoundFX.randomPitch(Paths.getPath('menus/scrollMenu', 'sound'), 0.9, 1.1);
		if (currentList == null || currentList.length == 0) {
			descText.text = "Press ENTER to configure controls.";
			return;
		}

		curSelectedOption = (curSelectedOption + change + currentList.length) % currentList.length;

		for (i in 0...itemTexts.length) {
			var isSelected = (i == curSelectedOption);
			if (!isCategory) {
				itemTexts[i].color = isSelected ? 0xFFFFFF00 : 0xFFFFFFFF;
				if (Std.isOfType(valueTexts[i], FlxText)) {
					cast(valueTexts[i], FlxText).color = isSelected ? 0xFFFFFF00 : 0xFFFFFFFF;
				}
			}
		}

		descText.text = currentList[curSelectedOption].description;
		updateCharacterVisibility();

		var selectedY = 20 + curSelectedOption * 50;
		var camBottom = contentCam.scroll.y + CONTENT_H;
		var itemH = 50;

		if (selectedY < contentCam.scroll.y)
			contentCam.scroll.y = selectedY;
		else if (selectedY + itemH > camBottom)
			contentCam.scroll.y = selectedY + itemH - CONTENT_H;

		if (curSelectedOption == 0)
			contentCam.scroll.y = 0;
	}

	function updateVisualFocus() {
		if (isCategory) {
			for (i in 0...categoryTexts.length) {
				if (i == curCategory) {
					categoryTexts[i].color = 0xFFFFFF00;
				} else {
					categoryTexts[i].color = 0xFFFFFFFF;
				}
			}

			if (itemTexts != null && itemTexts.length > 0 && curSelectedOption < itemTexts.length) {
				if (itemTexts[curSelectedOption] != null) {
					itemTexts[curSelectedOption].color = 0xFFFFFFFF;
				}
				if (valueTexts != null && valueTexts[curSelectedOption] != null) {
					if (Std.isOfType(valueTexts[curSelectedOption], FlxText)) {
						cast(valueTexts[curSelectedOption], FlxText).color = 0xFFFFFFFF;
					}
				}
			}
		} else {/*
			if (categoryTexts != null && categoryTexts.length > 0 && curCategory < categoryTexts.length) {
				if (categoryTexts[curCategory] != null)
					categoryTexts[curCategory].color = 0xFFFFFFFF;
			}*/

			for (i in 0...itemTexts.length) {
				if (i == curSelectedOption) {
					itemTexts[i].color = 0xFFFFFF00;
					if (Std.isOfType(valueTexts[i], FlxText)) {
						cast(valueTexts[i], FlxText).color = 0xFFFFFF00;
					}
				} else {
					itemTexts[i].color = 0xFFFFFFFF;
					if (Std.isOfType(valueTexts[i], FlxText)) {
						cast(valueTexts[i], FlxText).color = 0xFFFFFFFF;
					}
				}
			}
		}

		updateCharacterVisibility();
	}

	function changeOptionValue(direction:Int) {
		var currentList = categoryOptions.get(categories[curCategory]);
		if (currentList == null || currentList.length == 0)
			return;

		core.audio.SoundFX.randomPitch(Paths.getPath('menus/scrollMenu', 'sound'), 0.9, 1);

		var opt = currentList[curSelectedOption];
		var currentValue:Dynamic = Reflect.field(SaveData.data, opt.saveField);

		switch (opt.type) {
			case CHECKBOX:
				var newValue:Bool = !currentValue;
				Reflect.setField(SaveData.data, opt.saveField, newValue);

				var spr = valueTexts[curSelectedOption];
				if (spr != null && !Std.isOfType(spr, FlxText)) {
					if (newValue) {
						spr.animation.play('to_check', true);
					} else {
						spr.animation.play('to_uncheck', true);
					}
				}

				if (opt.saveField == 'antialiasing') {
					FlxSprite.defaultAntialiasing = newValue;
					updateAntialiasingLive(newValue);
				}
			case NUMBER(min, max, step):
				var newValue:Float = currentValue + (direction * step);
				if (newValue < min)
					newValue = min;
				if (newValue > max)
					newValue = max;
				Reflect.setField(SaveData.data, opt.saveField, Math.round(newValue));

				if (opt.saveField == 'framerate')
					core.api.AppUtil.updateFramerate(Math.round(newValue));

				var displayFormat = opt.displayFormat;
				if (displayFormat == null)
					displayFormat = '';

				if (Std.isOfType(valueTexts[curSelectedOption], FlxText)) {
					cast(valueTexts[curSelectedOption], FlxText).text = '< ' + Std.string(newValue) + displayFormat + ' >';
				}
			case STRING(options):
				var rawVal:Dynamic = Reflect.field(SaveData.data, opt.saveField);
				var currentIndex:Int = 0;

				if (Std.isOfType(rawVal, Int))
					currentIndex = cast(rawVal, Int);
				else if (Std.isOfType(rawVal, Float))
					currentIndex = Std.int(cast(rawVal, Float));
				else if (Std.isOfType(rawVal, Bool))
					currentIndex = (rawVal : Bool) ? 0 : 1;
				else if (Std.isOfType(rawVal, String)) {
					currentIndex = options.indexOf(cast(rawVal, String));
					if (currentIndex < 0)
						currentIndex = 0;
				}

				currentIndex += direction;
				if (currentIndex < 0)
					currentIndex = options.length - 1;
				if (currentIndex >= options.length)
					currentIndex = 0;

				Reflect.setField(SaveData.data, opt.saveField, options[currentIndex]);

				var selectedString:String = options[currentIndex];

				if (opt.saveField == 'windowmode') {
					switch (selectedString) {
						case 'Fullscreen':
							core.api.DesktopAPI.setFullscreen(true);
							core.api.DesktopAPI.setBorderless(false);
						case 'Windowed':
							core.api.DesktopAPI.setFullscreen(false);
							core.api.DesktopAPI.setBorderless(false);
						case 'Borderless':
							core.api.DesktopAPI.setFullscreen(false);
							core.api.DesktopAPI.setBorderless(true);
					}
				}

				if (Std.isOfType(valueTexts[curSelectedOption], FlxText)) {
					cast(valueTexts[curSelectedOption], FlxText).text = '< ' + selectedString + ' >';
				}
		}
		SaveData.flush();
	}

	function updateAntialiasingLive(enabled:Bool) {
		if (character != null) {
			character.antialiasing = enabled;
			if (character.layers != null) {
				for (layer in character.layers) {
					if (layer != null) {
						layer.antialiasing = enabled;
					}
				}
			}
		}

		for (txt in categoryTexts) {
			if (txt != null)
				txt.antialiasing = enabled;
		}
		for (txt in itemTexts) {
			if (txt != null)
				txt.antialiasing = enabled;
		}
		for (spr in valueTexts) {
			if (spr != null && !Std.isOfType(spr, FlxText))
				spr.antialiasing = enabled;
		}
		if (descText != null)
			descText.antialiasing = enabled;
	}

	function updateCharacterVisibility() {
		if (character == null)
			return;

		var showChar:Bool = false;

		if (!isCategory) {
			var currentList = categoryOptions.get(categories[curCategory]);
			if (currentList != null && currentList.length > 0 && curSelectedOption < currentList.length) {
				var optName = currentList[curSelectedOption].name;
				if (optName == 'Shaders' || optName == 'Antialiasing') {
					showChar = true;
				}
			}
		}

		character.visible = showChar;
		if (character.layers != null) {
			for (layer in character.layers) {
				if (layer != null) {
					layer.visible = showChar;
				}
			}
		}
	}

	override public function update(elapsed:Float) {
		super.update(elapsed);

		var currentList = categoryOptions.get(categories[curCategory]);
		var hasOptions = (currentList != null && currentList.length > 0);

		if (categories[curCategory] == 'Keybinds' && !isCategory && keybindsMenu != null) {
			keybindsMenu.handleInput();
			if (Controls.BACK) {
				isCategory = true;
				updateVisualFocus();
				FlxG.sound.play(Paths.getPath('menus/cancelMenu', 'sound'));
			}
			return;
		}

		if (descText != null)
			descText.visible = !isCategory;

		if (Controls.UI_LEFT) {
			if (!isCategory
				&& hasOptions
				&& currentList[curSelectedOption].type != CHECKBOX
				&& currentList[curSelectedOption].type != null) {
				updateVisualFocus();
				changeOptionValue(-1);
			}
		}

		if (Controls.UI_RIGHT) {
			if (!isCategory
				&& hasOptions
				&& currentList[curSelectedOption].type != CHECKBOX
				&& currentList[curSelectedOption].type != null) {
				updateVisualFocus();
				changeOptionValue(1);
			}
		}

		if (Controls.UI_UP) {
			if (!isCategory && hasOptions) {
				updateSelection(-1);
			} else {
				updateVisualFocus();
				changeCategory(-1);
			}
		}

		if (Controls.UI_DOWN) {
			if (!isCategory && hasOptions) {
				updateSelection(1);
			} else {
				updateVisualFocus();
				changeCategory(1);
			}
		}

		if (Controls.ACCEPT) {
			if (isCategory) {
				FlxG.sound.play(Paths.getPath('menus/confirmMenu', 'sound'));
				isCategory = false;
				updateVisualFocus();
				if (categories[curCategory] == 'Keybinds')
					reloadOptions();
			} else if (!isCategory && hasOptions) {
				var opt = currentList[curSelectedOption];
				if (opt.type == CHECKBOX) {
					updateVisualFocus();
					changeOptionValue(1);
				} else if (opt.name == 'Combo Position') {
					openSubState(new states.substates.menus.options.ComboPositionSubstate());
				}
			}
		}

		if (Controls.BACK) {
			if (!isCategory) {
				isCategory = true;
				updateVisualFocus();
				FlxG.sound.play(Paths.getPath('menus/cancelMenu', 'sound'));
			} else {
				if (game.PlayStateConfig.isPlaying)
					applyLiveChanges();
				close();
				FlxG.mouse.visible = false;
			}
		}
	}

	function applyLiveChanges():Void {
		var ps = game.PlayState.instance;
		if (ps == null)
			return;

		if (ps.noteController != null)
			ps.chars.syncGhostTapping();

		if (ps.noteController != null)
			ps.noteController.updateLaneBackdropAlpha();

		ps.playStateConfig.isBotplay = SaveData.data.botplay;

		// V-Slice scripts lay out their own HUD (space notes...) once, from where the arrows are; reload so they redo it -JloorDev
		var layoutChanged = ps.noteController.isDownscroll != SaveData.data.downscroll
			|| ps.noteController.isMiddlescroll != SaveData.data.middlescroll;
		if (layoutChanged && modding.vslice.VSlice.isActive() && modding.vslice.VSliceHooks.active) {
			var song = ps.songFolder;
			var diff = ps.curDifficulty;
			MusicBeatState.switchState(() -> new states.menus.LoadingState(song, diff));
			return;
		}

		ps.noteController.applyScrollDirection(SaveData.data.downscroll);
		ps.noteController.applyMiddlescroll(SaveData.data.middlescroll);

		ps.modchartSystem.syncBase();

		updateAntialiasingLivePlayState(SaveData.data.antialiasing);
	}

	function updateAntialiasingLivePlayState(enabled:Bool):Void {
		var ps = game.PlayState.instance;
		if (ps == null)
			return;

		if (ps.noteController != null)
			ps.noteController.updateAntialiasingLive(enabled);

		if (ps.chars != null) {
			for (charData in game.PlayState.SONG.chars) {
				var char = cast(ps.chars.get(charData.id), game.objects.sprites.Character);
				if (char == null)
					continue;
				char.antialiasing = enabled;
				if (char.layers != null)
					for (layer in char.layers)
						if (layer != null)
							layer.antialiasing = enabled;
			}
		}

		if (ps.controllerHUD != null) {
			for (member in ps.controllerHUD.members)
				if (member != null && Std.isOfType(member, flixel.FlxSprite))
					cast(member, flixel.FlxSprite).antialiasing = enabled;
		}

		if (ps.stage != null) {
			for (member in ps.stage.members) {
				if (member != null && Std.isOfType(member, flixel.FlxSprite))
					cast(member, flixel.FlxSprite).antialiasing = enabled;
			}
		}
	}

	override function beatHit(beat:Float) {
		super.beatHit(beat);

		if (character != null && character.visible) {
			character.dance();
		}
	}

	override function destroy() {
		if (character != null) {
			if (character.layers != null) {
				for (layer in character.layers) {
					if (layer != null) {
						remove(layer);
						layer.destroy();
					}
				}
			}
			remove(character);
			character.destroy();
			character = null;
		}

		if (gridBg != null) {
			remove(gridBg);
			gridBg.destroy();
			gridBg = null;
		}

		if (contentCam != null) {
			FlxG.cameras.remove(contentCam, true);
		}
		contentCam = null;

		super.destroy();

		categoryTexts = null;
		itemTexts = null;
		valueTexts = null;
		descText = null;
	}
}
